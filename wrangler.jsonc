{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "craftalneurerscaseathon2026",
  "main": "cloudflare/worker.ts",
  "compatibility_date": "2026-10-23",
  "upload_source_maps": true,
  "observability": {
    "enabled": true
  },
  "routes": [
    {
      "pattern": "antydata.com",
      "custom_domain": true
    }
  ],
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "run_worker_first": [
      "/api",
      "/api/*"
    ]
  },
  "durable_objects": {
    "bindings": [
      {
        "name": "DECISIONS",
        "class_name": "DecisionStore"
      }
    ]
  },
  "exports": {
    "DecisionStore": {
      "type": "durable-object",
      "storage": "sqlite"
    }
  }
}
